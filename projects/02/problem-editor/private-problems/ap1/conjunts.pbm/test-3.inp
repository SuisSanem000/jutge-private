print(has_duplicates([]))
print(has_duplicates([1]))
print(has_duplicates([1,1]))
print(has_duplicates([2,1]))
print(has_duplicates([1,2]))
print(has_duplicates([1,2,3]))
print(has_duplicates([1,1,3]))
print(has_duplicates([1,2,1]))
print(has_duplicates([1,1,2]))
print(has_duplicates([2,1,1]))
print(has_duplicates(list(range(100_000))))
print(has_duplicates(list(range(100_000)) + [4]))

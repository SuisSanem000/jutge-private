print(round(average(set([12.0, 8.5, 9.5])), 2))
print(round(average(set([1])), 2))
print(round(average(set([1, 2])), 2))
print(round(average(set([1, 2, 3])), 2))
print(round(average(set([-1])), 2))
print(round(average(set([-1, 2])), 2))
print(round(average(set([-1, 2, 3])), 2))
print(round(average(set(range(1000000))), 2))
